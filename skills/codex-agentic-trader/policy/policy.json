{
  "policy_version": "2.0-20260813-supervised",
  "note": "唯一策略参数源，只有账户所有人能改。mandate 是必要但不充分的限时限额委托，不得绕过平台确认或放宽本 policy。",
  "account_last4": "0000",
  "capital_cap": 5000.0,
  "benchmarks": ["VTI", "QQQM"],
  "market_timezone": "America/New_York",
  "max_data_age_seconds": 300,
  "max_review_age_seconds": 120,
  "max_clock_skew_seconds": 30,
  "max_mandate_days": 30,
  "supported_execution_modes": ["supervised_review"],
  "market_state_stock_caps": {"both_pass": 0.9, "one_pass": 0.6, "none_pass": 0.2},
  "drawdown_tiers": [
    {"threshold": 0.15, "stock_cap": 0.7},
    {"threshold": 0.25, "stock_cap": 0.4},
    {"threshold": 0.35, "stock_cap": 0.0}
  ],
  "halt_drawdown_threshold": 0.35,
  "single_stock_max_weight": 0.15,
  "stocks_total_max_weight": 0.30,
  "max_stock_positions": 2,
  "max_orders_per_day": 6,
  "max_daily_turnover_ratio": 0.30,
  "max_open_orders_per_symbol": 1,
  "min_weight_deviation": 0.03,
  "min_cash_buffer": 10.0,
  "max_spread_bps": 50.0,
  "new_risk_not_before_et": "10:00",
  "regular_session_start_et": "09:30",
  "regular_session_end_et": "16:00",
  "wash_sale_window_days": 30,
  "stock_entry": {
    "min_price": 5.0,
    "min_market_cap": 10000000000,
    "min_avg_daily_volume": 1000000,
    "min_days_to_earnings": 3
  },
  "valid_triggers": [
    "weight_deviation",
    "market_state_change",
    "drawdown_action",
    "thesis_break",
    "qualified_candidate"
  ],
  "risk_exit_triggers": ["thesis_break", "drawdown_action"],
  "allowed_asset_classes": ["stock", "etf", "cash_equiv"],
  "etf_symbols": ["VTI", "QQQM"],
  "cash_equiv_symbols": ["SGOV"],
  "min_order_amount": 10.0,
  "allowed_order_types": ["market_day", "limit_day"],
  "stock_exit": {
    "loss_from_cost_pct": 0.12,
    "closes_below_50dma": 2,
    "exit_on_daily_close_below_200dma": true,
    "allowed_signals": [
      "thesis_invalidated",
      "loss_from_cost_12pct",
      "two_closes_below_50dma",
      "daily_close_below_200dma",
      "material_event_risk"
    ]
  },
  "mandate_file": "~/.codex-agentic-trader/mandate.json",
  "halt_file": "~/.codex-agentic-trader/HALT",
  "gate_state_file": "~/.codex-agentic-trader/gate_state.json",
  "order_ledger_file": "~/.codex-agentic-trader/order_ledger.json",
  "journal_file": "~/.codex-agentic-trader/journal.jsonl",
  "keychain_service": "com.roy.codex-agentic-trader.mandate"
